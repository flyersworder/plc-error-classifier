  <types>
    <dataTypes/>
    <pous>
      <pou name="DataLogger" pouType="program">
        <interface>
          <localVars>
            <variable name="LogCounter">
              <type><DINT/></type>
            </variable>
            <variable name="SensorValue">
              <type><REAL/></type>
            </variable>
            <variable name="LogEnabled">
              <type><BOOL/></type>
            </variable>
          </localVars>
          <externalVars>
            <variable name="EXTERNAL_TIMESTAMP">
              <type><TIME/></type>
            </variable>
          </externalVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">
IF LogEnabled THEN
    LogCounter := LogCounter + 1;
    (* Attempt to use external logging function *)
    LOG_RECORD(LogCounter, SensorValue);
END_IF;
            </xhtml>
          </ST>
        </body>
      </pou>
    </pous>
